[
  {
    "name": "summary keeps permalink and nested values",
    "source": "---\npermalink: stable\nextra: {a: 2}\n---\nbody\n",
    "key": "summary",
    "value": "true",
    "reads": {
      "summary": "true",
      "permalink": "stable"
    },
    "metadata": {
      "extra": {
        "a": 2
      }
    },
    "suffix": "---\nbody\n"
  },
  {
    "name": "new permalink keeps Unicode body",
    "source": "\n# 문서\n\n원문 🌱  \n",
    "key": "permalink",
    "value": "/notes/생각",
    "reads": {
      "permalink": "/notes/생각"
    },
    "suffix": "---\n\n# 문서\n\n원문 🌱  \n"
  },
  {
    "name": "BOM CRLF comments and unknown mapping",
    "source": "﻿---\r\n# 속성 메모\r\nsummary: 기존 요약\r\ntags: [a, b]\r\ncustom: {count: 2, enabled: true}\r\npermalink: /old\r\n...\r\n\r\n# 본문\r\n  그대로\r\n",
    "key": "permalink",
    "value": "true",
    "reads": {
      "permalink": "true",
      "summary": "기존 요약"
    },
    "metadata": {
      "custom": {
        "count": 2,
        "enabled": true
      },
      "tags": [
        "a",
        "b"
      ]
    },
    "comments": [
      "# 속성 메모\r\n"
    ],
    "suffix": "...\r\n\r\n# 본문\r\n  그대로\r\n"
  },
  {
