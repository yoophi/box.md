{
  "name": "@box/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "prepare:server": "node ../../scripts/prepare-workbench-server.mjs",
    "prepare:server:dev": "node ../../scripts/prepare-workbench-server.mjs --debug",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "playwright test",
    "fixture:native-browser": "node tests/native/site-browser-fixture.mjs",
    "test:native-browser-fixture": "node --test tests/native/site-browser-fixture.test.mjs",
    "test:native-browser-pages": "playwright test --config playwright.native-fixture.config.ts"
  },
  "dependencies": {
    "@box/contracts": "workspace:*",
    "@box/editor": "workspace:*",
    "@box/ui": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@yoophi/workbench-agent-client": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@yoophi/workbench-client": "workspace:*",
    "jsdom": "30.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
