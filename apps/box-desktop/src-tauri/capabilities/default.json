{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main desktop window core permissions",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "deep-link:default",
    "clipboard-manager:allow-write-text",
    "allow-set-exit-allowed",
    "allow-get-app-info",
    "allow-get-workbench-connection",
    "allow-get-document-mcp-grant",
    "allow-revoke-document-mcp-grant",
    "allow-open-document",
    "allow-save-document",
    "allow-create-document",
    "allow-duplicate-document",
    "allow-document-revision",
    "allow-document-history",
    "allow-history-content",
    "allow-list-workspace-documents",
    "allow-select-document-workspace",
    "allow-list-document-comments",
    "allow-add-document-comment",
    "allow-list-connections",
    "allow-create-connection-entity",
    "allow-attach-document-connection",
    "allow-detach-document-connection",
    "allow-site-browser-open",
    "allow-site-browser-layout",
    "allow-site-browser-action",
    "allow-site-browser-snapshot",
    "allow-site-browser-selection"
  ]
}
