{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "box.md",
  "version": "0.1.0",
  "identifier": "com.yoophi.box-md",
  "build": {
    "beforeDevCommand": "pnpm run prepare:server:dev && pnpm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm run prepare:server && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "box.md",
        "width": 1100,
        "height": 760,
        "minWidth": 600,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/agentic-workbench-server"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "boxmd"
        ]
      }
    }
  }
}
